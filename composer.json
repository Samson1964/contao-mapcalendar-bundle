{
    "name": "schachbulle/contao-mapcalendar-bundle",
    "type": "contao-bundle",
    "description": "Terminübersicht mit anklickbarer Deutschlandkarte und Filter nach Veranstaltungsart, entwickelt für die Website des Deutschen Schachbundes.",
    "keywords": ["contao", "kalender", "termine", "deutschlandkarte", "landesverband", "schach", "dsb"],
    "homepage": "https://github.com/Samson1964/contao-mapcalendar-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "redmind GmbH",
            "email": "info@redmind.de",
            "role": "Ursprünglicher Autor"
        },
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/",
            "role": "Wartung"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13",
        "contao/calendar-bundle": "^4.13",
        "menatwork/contao-multicolumnwizard-bundle": "^3.4",
        "schachbulle/contao-eventtypes-bundle": "^1.0",
        "symfony/http-foundation": "^5.4"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3.1"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoMapcalendarBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoMapcalendarBundle\\ContaoManager\\Plugin"
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-mapcalendar-bundle/issues",
        "source": "https://github.com/Samson1964/contao-mapcalendar-bundle"
    }
}
